# Local Ollama Configuration
# URL of your local Ollama instance (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Default model to use (default: qwen2.5:3b)
AI_MODEL=qwen2.5:3b

# Security & Permission Gate
# 0 = SAFE MODE (Interactively prompts (y/n) confirmation before writing, modifying, or deleting files)
# 1 = WRITE MODE (Auto-permits write/delete actions without confirmation prompts)
KIRAHT_ALLOW_WRITES=0

# Google Gemini Cloud Engine (Optional: for cloud fallback & Vision AI)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

